{
  "name": "mantrabe",
  "version": "0.7.0",
  "description": "Mantrabe — a serene cross-platform mantra reminder. Works offline; optional cloud sync.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/version.cjs sync && tsc --noEmit && vite build",
    "preview": "vite preview",
    "version:show": "node scripts/version.cjs show",
    "version:bump": "node scripts/version.cjs bump build",
    "version:bump:minor": "node scripts/version.cjs bump minor",
    "version:bump:major": "node scripts/version.cjs bump major",
    "version:sync": "node scripts/version.cjs sync",
    "release": "node scripts/version.cjs release",
    "cap:sync": "yarn build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "electron": "electron .",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "build:android": "bash scripts/build-android.sh",
    "build:android-bump": "bash scripts/build-android.sh minor",
    "build:android-adb": "bash scripts/run-android-adb.sh debug",
    "build:android-adb-production": "bash scripts/run-android-adb.sh production",
    "adb": "bash scripts/adb-launch.sh debug",
    "adb-production": "bash scripts/adb-launch.sh production",
    "build:ios": "bash scripts/build-ios.sh",
    "build:linux": "bash scripts/build-linux.sh",
    "build:all": "bash scripts/build-all.sh",
    "dist:linux": "yarn build && electron-builder --linux --publish never"
  },
  "packageManager": "yarn@4.5.3",
  "keywords": [
    "mantra",
    "mindfulness",
    "reminder",
    "meditation",
    "capacitor",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "com.mantrabe.app",
    "productName": "Mantrabe",
    "files": [
      "dist/**/*",
      "!dist/mantrabe-android.apk",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  }
}
