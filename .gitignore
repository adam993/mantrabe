# Dependencies
node_modules/

# Yarn 4 caches & runtime — but we DO commit .yarn/releases/ and .yarnrc.yml
# so the project bootstraps without corepack network access.
.yarn/*
!.yarn/releases
!.yarn/patches
!.yarn/plugins
.yarn/install-state.gz
.pnp.*

# Build output
dist/
release/

# Capacitor native projects (regenerated by build scripts)
android/
ios/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated icon (regenerated by build scripts)
assets/icon.png

# Generated by scripts/version.cjs from version.json — committed file is
# version.json, not the JS view of it. Avoids per-build noise in diffs.
src/version.js

# Generated by scripts/prepare-public-apk.cjs.
src/build-info.js
public/mantrabe-android.apk

# Local environment
.env
.env.local

# Swift toolchain artifacts left behind by iOS-on-Linux attempts (swiftly).
# iOS builds happen on macOS via Xcode; we don't need a local Swift toolchain.
.swift-version
swiftly*.tar.gz
LICENSE.txt
