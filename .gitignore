# Dependencies
node_modules/

# Yarn 4 caches & runtime — but we DO commit .yarn/releases/ and .yarnrc.yml
# so the project bootstraps without corepack network access.
.yarn/*
!.yarn/releases
!.yarn/patches
!.yarn/plugins
.yarn/install-state.gz
.pnp.*

# Build output
dist/
release/

# Capacitor native projects (regenerated by build scripts)
android/
ios/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated icon (regenerated by build scripts)
assets/icon.png

# Local environment
.env
.env.local
