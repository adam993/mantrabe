# Mantrabe — optional cloud sync via Supabase.
#
# Cloud sync is optional. If these are unset, the app still works fully —
# local storage stays the source of truth. Copy this file to .env.local and
# fill in values from your Supabase project's API settings.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
