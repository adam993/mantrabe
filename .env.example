# Mantrabe — env vars reference. Copy to .env.local and fill in.
#
# Only the VITE_* vars are read by the web bundle at build time. Everything
# else is reference-only — the value is configured elsewhere (e.g. Supabase
# dashboard) and lives here just so future-you remembers what's wired up.

# ─── Cloud sync (optional) ─────────────────────────────────────────────
# Supabase project credentials. If unset, the app runs fully offline and
# local storage stays the source of truth. Find these at:
#   https://supabase.com/dashboard/project/<PROJECT-REF>/settings/api-keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ─── Auth email delivery (reference only) ──────────────────────────────
# Custom SMTP for Supabase Auth (magic links, confirmations) routes through
# Brevo. The actual values are configured in the Supabase dashboard at
#   Authentication → Emails → SMTP Settings
# (host smtp-relay.brevo.com, port 587, login = the Brevo account email).
# This var is kept here only so the SMTP key is recoverable from one place.
# Rotate via Brevo → SMTP & API → Generate a new SMTP key.
BREVO_SMTP_KEY=YOUR-BREVO-SMTP-KEY

# ─── Debug build flavor (optional, build-time only) ────────────────────
# When set to "true", the bundle includes a developer-only "fire a test
# notification" button on the list screen for verifying notifications on
# real devices. Set automatically by `yarn build:android-adb`. Leave
# unset (or "false") for production builds — `yarn build:android` and
# `yarn build:android-adb-production` both omit it.
VITE_DEBUG_TOOLS=false
