<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — the brushed enso from the empty-state logo
  in the web app (the `strong` variant of <Enso/>). 108x108 matches
  Android's adaptive-icon convention; the inner 66dp safe zone is what
  the launcher will always show, so the enso (r=32 around the center)
  fills it confidently without risking a crop.

  We avoid trimPathStart/trimPathEnd here because static VectorDrawable
  rendering of those is buggy on multiple OEM launchers — when they
  fail, the icon falls back to whatever PNG mipmap-anydpi-v26 picks up
  from the legacy density buckets, which is Capacitor's default robot.
  Instead, the brushed gap is baked into the path: the arc starts at
  ~280.8° and sweeps clockwise back to ~259.2°, leaving a ~21° gap
  centered at the top. The wrapping <group> rotates the whole thing
  -22° so the gap reads as a brushstroke break in the upper-right,
  matching the website logo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-22">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#2a241c"
            android:strokeWidth="4"
            android:strokeAlpha="0.85"
            android:strokeLineCap="round"
            android:pathData="M 60 22.6 A 32 32 0 1 1 48 22.6" />
    </group>
</vector>
