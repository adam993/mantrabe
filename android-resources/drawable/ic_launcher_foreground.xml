<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — the brushed enso + warm-gold dot from
  public/icon.svg, expressed as a VectorDrawable so it renders crisp at
  any density.

  The 108x108 viewport matches Android's adaptive-icon convention: the
  outer ~18dp ring will be cropped/masked by the launcher (square,
  circle, squircle…), so the iconography stays inside the inner 72dp
  safe zone. Hence the enso is sized to ~24dp radius around the center.

  VectorDrawable doesn't support stroke-dasharray, so the brushed gap
  is approximated with `trimPathStart`/`trimPathEnd` — a single visible
  break in the stroke instead of the multi-dash pattern from the SVG.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-22">
        <path
            android:strokeColor="#2a241c"
            android:strokeWidth="3.6"
            android:strokeLineCap="round"
            android:trimPathStart="0.04"
            android:trimPathEnd="0.97"
            android:pathData="M 30 54 a 24 24 0 1 1 48 0 a 24 24 0 1 1 -48 0 Z" />
    </group>
    <!-- Warm-gold dot at the top, in the unrotated frame. -->
    <path
        android:fillColor="#b08d57"
        android:pathData="M 54 22 m -2.8 0 a 2.8 2.8 0 1 0 5.6 0 a 2.8 2.8 0 1 0 -5.6 0 Z" />
</vector>
